{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keystone",
  "version": "0.1.3",
  "identifier": "app.keystone.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Keystone",
        "width": 1340,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "backgroundColor": "#0C0C0C"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/swendlcode/keystone-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyMTFGNEY3NTcxNTdFNUYKUldSZmZoVlg5L1FSWXI1UHJyNHpYYXp1WUdrUmlwTThSbVdnUGxBK3ZwYTFmaTJsZlk4QUhJVFkK"
    }
  }
}
